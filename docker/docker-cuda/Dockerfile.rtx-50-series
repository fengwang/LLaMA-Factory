# CUDA 12.8 provides native support for consumer Blackwell (sm_120).
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel

ARG PIP_INDEX=https://pypi.org/simple
ARG MAX_JOBS=4

ENV VLLM_WORKER_MULTIPROC_METHOD=spawn \
    DEBIAN_FRONTEND=noninteractive \
    PIP_ROOT_USER_ACTION=ignore \
    TORCH_CUDA_ARCH_LIST="12.0"

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --index-url "${PIP_INDEX}" \
        --upgrade pip packaging wheel setuptools ninja einops editables "hatchling>=1.18.0"

# Build FA2 against this image's PyTorch ABI, even without a GPU at build time.
# FLASH_ATTN_CUDA_ARCHS, rather than TORCH_CUDA_ARCH_LIST, controls FA2's targets.
RUN FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS=120 \
    MAX_JOBS=${MAX_JOBS} NVCC_THREADS=2 \
    pip install --no-cache-dir --index-url "${PIP_INDEX}" \
        --no-build-isolation --no-deps "flash-attn==2.8.3"

COPY . /app

# Keep PyTorch compatible with the compiled FA2 extension.
RUN pip install --no-cache-dir --index-url "${PIP_INDEX}" --no-build-isolation \
        "torch==2.8.0" "torchvision==0.23.0" "torchaudio==2.8.0" \
        -e . -r requirements/metrics.txt -r requirements/deepspeed.txt && \
    python -c "import torch, flash_attn; assert flash_attn.__version__ == '2.8.3'"

ENV GRADIO_SERVER_PORT=7860 \
    API_PORT=8000
EXPOSE 7860 8000
CMD ["bash"]
